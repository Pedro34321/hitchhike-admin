PORT=3000
# Configure HTTPS no proxy e defina em produção:
NODE_ENV=production
# Opcional: caminho absoluto do SQLite
# DB_PATH=/var/lib/hitchhike/admin.sqlite
# Caminho absoluto do JSON da conta de serviço do projeto hitchhike-9568f.
# Baixe no Firebase Console, em Configurações do projeto > Contas de serviço.
# Guarde o arquivo fora desta pasta. Não cole a chave neste arquivo.
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/Users/isabe/secrets/hitchhike-9568f-firebase-adminsdk.json


# --- Pagamentos de TESTE (Mercado Pago Checkout Pro) ---
# Somente credenciais de TESTE da conta vendedora de teste. Nunca use credenciais de produção.
# Defina os valores no ambiente (.env local, ignorado pelo Git, ou painel do Render), nunca neste arquivo.
# MERCADOPAGO_ACCESS_TOKEN=
# Chave secreta exibida em Suas integrações > Webhooks > Configurar notificações (assinatura secreta).
# MERCADOPAGO_WEBHOOK_SECRET=
# URL pública HTTPS do backend (sem barra no final). Sem ela, o webhook e as URLs de retorno não são enviados ao Mercado Pago.
# PUBLIC_BASE_URL=
# Opcional: init_point (padrão) ou sandbox_init_point. Veja docs/PAGAMENTOS.md.
# MERCADOPAGO_CHECKOUT_URL=init_point
